# DreamForge environment variables
# Copy this file to .env (and optionally .env.development / .env.production)
# and fill in values for your machine. Do not commit real secrets.
#
# Vite inlines VITE_* values at build time. Runtime PC vs phone detection
# still decides which generator URL is used.

# Last-resort fallback for "is this a PC?" when User-Agent is inconclusive.
# Set to true for local PC development builds.
# Leave empty in production builds: a desktop User-Agent still counts as PC.
VITE_DEFAULT_IS_PC=true

# Where the app talks to the local bridge / generator on this machine.
VITE_GENERATOR_API_URL=http://127.0.0.1:8898

# Reachable URL for phones or other devices on the same network.
# Replace 192.168.1.10 with your PC's LAN IP (bridge.py prints it on startup).
# Over a VPN, use the VPN/WireGuard IP instead, for example:
#   VITE_GENERATOR_LAN_URL=http://10.0.0.2:8898
VITE_GENERATOR_LAN_URL=http://192.168.1.10:8898

# --- Server-side only (never expose these to the browser) ---
# Used by the Brainstormer "Talk it through" council (Dream + Nyna).
# Option A: your own DeepSeek key
DEEPSEEK_API_KEY=

# Option B: Lovable AI gateway + DeepSeek connector (both required together)
LOVABLE_API_KEY=
UDC_DEEPSEEK_API_KEY=

# Optional: URL of a real image/video generator for bridge.py to call.
# Until this is set, POST /generate/image and /generate/video return 501.
# Example if you later run a local generator:
# GENERATOR_URL=http://127.0.0.1:11434
GENERATOR_URL=
